# tradeflow configuration. Copy to .env and fill in. NEVER commit .env.
# Defaults are safe: paper mode on the simulated feed. Every setting is listed here
# with its default; lines you don't need to change can stay as they are.
# Times are IST, HH:MM. Money is INR. Lists and maps are JSON.

# --- mode ---------------------------------------------------------------------
# paper = live market data (or sim), simulated fills, no real orders.
# live  = REAL ORDERS WITH REAL MONEY. Live mode refuses to start unless
#         MODE=live, LIVE_TRADING_CONFIRMED=true, ADMIN_TOKEN (16+ chars),
#         FEED=kite and Kite API keys are all set. Read the README's going-live
#         checklist first.
MODE=paper
# kite = Kite WebSocket market data (needs the daily Kite login); sim = random-walk feed
FEED=sim
LIVE_TRADING_CONFIRMED=false
# postgres = durable journal (required for live). memory = practice without a
# database (paper only); trades, plans and test results are lost when it stops.
STORAGE=postgres

# --- auth ---------------------------------------------------------------------
# Dashboard/API admin token, at least 16 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change-me-to-a-long-random-string
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Your Kite client id (e.g. AB1234). Logins from any other account are rejected.
KITE_USER_ID=
# Kite developer console -> redirect URL. With docker compose the dashboard proxies the
# API under /api, so it is:  https://<your-domain>/api/auth/callback
# (local: http://localhost:8080/api/auth/callback). It must match exactly.
# Where the browser lands after the Kite login:
FRONTEND_URL=http://localhost:8080
# The only origin allowed by CORS. The dashboard is same-origin behind nginx, so this
# only matters for the Vite dev server (`npm run dev`).
FRONTEND_ORIGIN=http://localhost:5173
# Dashboard port binding (docker compose). Keep 127.0.0.1 and use an SSH tunnel or a
# TLS reverse proxy in front; never expose the dashboard over plain HTTP.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080

# --- infrastructure -----------------------------------------------------------
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradeflow
# Used when running the backend outside Docker (compose sets its own values).
DATABASE_URL=postgresql+asyncpg://tradeflow:change-me@localhost:5432/tradeflow
REDIS_URL=redis://localhost:6379/0

# --- market hours and trading window ----------------------------------------------
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
# New (risk-increasing) orders only inside [TRADING_START, TRADING_END).
TRADING_START=09:15
TRADING_END=15:10
# Daily MIS square-off (NRML positions carry over).
SQUARE_OFF_TIME=15:15
# Kite access tokens die at this time every day; the backend stops and restarts.
SESSION_EXPIRY_TIME=06:00

# --- risk limits --------------------------------------------------------------------
MAX_LOTS_PER_ORDER=1
MAX_OPEN_POSITIONS=6
MAX_ORDERS_PER_MINUTE=30
# INR, net of charges. Breaching it trips the kill switch.
DAILY_LOSS_LIMIT=500
# Defaults for the daily plan (the Plan page pre-fills them; 0 = no limit).
# Profit target: reached = no new trades today. Max trades: new entries per day.
PROFIT_TARGET=1500
MAX_TRADES_PER_DAY=1
# Same strategy/instrument/side/quantity within this many seconds is rejected.
DUPLICATE_ORDER_WINDOW_SEC=2

# --- Kite order handling ---------------------------------------------------------------
# MARKET / SL-M API orders: -1 = automatic protection, or 0 < x <= 100 (%).
MARKET_PROTECTION=-1
# Must stay below Kite's 10 orders/sec (above that needs exchange registration).
ORDER_RATE_PER_SEC=8
ORDER_RATE_PER_MIN=350

# --- paper trading / backtests ------------------------------------------------------
PAPER_SLIPPAGE_TICKS=1
# Paper margin estimate: set PAPER_CAPITAL to the capital you will trade live with.
# Futures and short options block PAPER_MARGIN_PCT of notional; long options their premium.
PAPER_CAPITAL=1000000
PAPER_MARGIN_PCT=0.15
# Pre-trade margin check (live: Kite's margin APIs; paper: the estimate above).
MARGIN_CHECK_ENABLED=true

# --- F&O ----------------------------------------------------------------------------------
# Exchange freeze quantity in UNITS per underlying. THESE CHANGE: verify against current
# NSE circulars. Orders above it are auto-sliced by Kite (max 10 slices).
FREEZE_LIMITS={"NIFTY":1800,"BANKNIFTY":900,"FINNIFTY":1800,"MIDCPNIFTY":2800}
# Cash-settled index underlyings; everything else is treated as physically settled.
INDEX_UNDERLYINGS=["NIFTY","BANKNIFTY","FINNIFTY","MIDCPNIFTY","SENSEX","BANKEX"]
# Black-Scholes rate for IV and Greeks.
RISK_FREE_RATE=0.065
# Options: MARKET requests are sent as LIMIT orders priced from bid/ask + buffer...
OPTION_LIMIT_ORDERS=true
OPTION_LIMIT_BUFFER_TICKS=2
# ...exits use a wider buffer (% beyond the far side) so they get done...
OPTION_EXIT_BUFFER_PCT=2.0
# ...and unfilled orders are re-priced toward the market every N seconds, up to M times.
OPTION_CHASE_AFTER_SEC=5
OPTION_CHASE_MAX=10
# Option entries are rejected if the spread (% of mid) or day volume (units) is worse.
OPTION_MAX_SPREAD_PCT=5.0
OPTION_MIN_VOLUME=10000
# Exchange-side stops are SL (stop-limit) orders with the limit this % beyond the trigger.
STOP_LIMIT_BUFFER_PCT=5.0
# No new entries in a contract on its expiry day after this time.
EXPIRY_NO_ENTRY_AFTER=14:30
# Stock (physically settled) F&O positions are exited N trading days before expiry.
PHYSICAL_SETTLEMENT_EXIT_DAYS=1
PHYSICAL_SETTLEMENT_EXIT_TIME=15:00
# Multi-leg orders not fully filled within this time are unwound.
LEG_GROUP_TIMEOUT_SEC=30

# --- charges (Zerodha, NSE F&O) ----------------------------------------------------------
# THESE CHANGE. Taken from zerodha.com/charges on 2026-11-07; verify before trusting net P&L.
BROKERAGE_PER_ORDER=20
BROKERAGE_FUTURES_PCT=0.03
STT_FUTURES_SELL_PCT=0.05
STT_OPTIONS_SELL_PCT=0.15
EXCHANGE_TXN_FUTURES_PCT=0.00183
EXCHANGE_TXN_OPTIONS_PCT=0.03553
SEBI_FEE_PER_CRORE=10
IPFT_PER_CRORE=0.01
STAMP_FUTURES_BUY_PCT=0.002
STAMP_OPTIONS_BUY_PCT=0.003
GST_PCT=18

# --- historical data ------------------------------------------------------------------------
# Days per Kite historical request by interval (not stated in Kite's docs; verify).
HISTORY_CHUNK_DAYS={"minute":60,"3minute":100,"5minute":100,"10minute":100,"15minute":200,"30minute":200,"60minute":400,"day":2000}
# Daily 15:40 recording of 1-minute candles (expired contracts can't be fetched later):
# spot, nearest future and ATM +/- RECORD_STRIKES_WIDTH strikes, nearest RECORD_EXPIRIES.
RECORD_UNDERLYINGS=["NIFTY","BANKNIFTY"]
RECORD_STRIKES_WIDTH=10
RECORD_EXPIRIES=2

# --- Telegram alerts (optional) -------------------------------------------------------------
# Create a bot with @BotFather; get the chat id by messaging the bot and opening
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- strategies and API -------------------------------------------------------------------------
STRATEGIES_FILE=strategies.yaml
# Params changed from the dashboard are saved here and survive restarts. Docker sets it
# to /app/state/strategies.local.yaml (a volume); only set it when running without Docker.
# STRATEGY_OVERRIDES_FILE=strategies.local.yaml
# /docs and /openapi.json are unauthenticated; keep them off in production.
API_DOCS=false

# --- process ------------------------------------------------------------------------------------
ENGINE_AUTOSTART=true
# After the daily Kite token expiry, exit so Docker restarts a fresh process.
EXIT_ON_SESSION_EXPIRY=true

# --- logging ------------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
