# Copy to .env and fill in. NEVER commit .env.
# Defaults are safe: paper mode on the simulated feed.

# --- mode -------------------------------------------------------------------
# paper = live market data (or sim), simulated fills, no real orders.
# live  = REAL ORDERS WITH REAL MONEY. Live mode refuses to start unless
#         MODE=live, LIVE_TRADING_CONFIRMED=true, ADMIN_TOKEN (16+ chars),
#         FEED=kite and Kite API keys are all set.
MODE=paper
# kite = Kite WebSocket market data (needs a daily Kite login); sim = random-walk feed
FEED=sim
LIVE_TRADING_CONFIRMED=false

# --- auth -------------------------------------------------------------------
# Dashboard/API admin token, at least 16 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change-me-to-a-long-random-string
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Your Kite client id (e.g. AB1234). Logins from any other account are rejected.
KITE_USER_ID=
# Kite developer console -> redirect URL. With docker compose the dashboard proxies the
# API under /api, so it is:  https://<your-domain>/api/auth/callback
# (local: http://localhost:8080/api/auth/callback). It must match exactly.
# Where the browser lands after the Kite login, and the only origin allowed by CORS
# (the dashboard is same-origin behind nginx; CORS only matters for `npm run dev`).
FRONTEND_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
# Dashboard port binding (docker compose). Keep 127.0.0.1 and use an SSH tunnel or a
# TLS reverse proxy in front; never expose the dashboard over plain HTTP.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080

# --- infrastructure ---------------------------------------------------------
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradeflow
DATABASE_URL=postgresql+asyncpg://tradeflow:change-me@localhost:5432/tradeflow
REDIS_URL=redis://localhost:6379/0

# --- trading window (IST, HH:MM) ---------------------------------------------
TRADING_START=09:15
TRADING_END=15:10
SQUARE_OFF_TIME=15:15

# --- risk limits ------------------------------------------------------------
MAX_LOTS_PER_ORDER=10
MAX_OPEN_POSITIONS=6
MAX_ORDERS_PER_MINUTE=30
# INR, net of charges. Breaching it trips the kill switch.
DAILY_LOSS_LIMIT=10000
DUPLICATE_ORDER_WINDOW_SEC=2

# --- Kite order handling ----------------------------------------------------
# MARKET / SL-M API orders: -1 = automatic protection, or 0 < x <= 100 (%).
MARKET_PROTECTION=-1
# Must stay below Kite's 10 orders/sec (above that needs exchange registration).
ORDER_RATE_PER_SEC=8
ORDER_RATE_PER_MIN=350

# --- paper trading ----------------------------------------------------------
PAPER_SLIPPAGE_TICKS=1

# --- Telegram alerts (optional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API ----------------------------------------------------------------------
# /docs and /openapi.json are unauthenticated; keep them off in production.
API_DOCS=false
# Strategy params changed from the dashboard are saved here (survive restarts).
STRATEGY_OVERRIDES_FILE=strategies.local.yaml

# --- process ----------------------------------------------------------------
ENGINE_AUTOSTART=true
# After the daily Kite token expiry, exit so Docker restarts a fresh process.
EXIT_ON_SESSION_EXPIRY=true

# --- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
